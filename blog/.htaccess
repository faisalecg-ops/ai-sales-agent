# Event Blog — server rules (Apache / LiteSpeed on cPanel)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Private folders are never served.
RewriteRule ^(core|config|storage|lang|themes|tests|content-packs)(/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]

# Some cPanel servers drop the Authorization header; pass it on for the API.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# The API has its own entry point.
RewriteRule ^api/(.*)$ api/index.php [L,QSA]

# Real files and folders (assets, uploads, admin) are served as they are.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else is a blog page.
RewriteRule ^ index.php [L,QSA]
</IfModule>

# Speed: compress text and let browsers keep fonts, images and styles.
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/gif "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
</IfModule>
<IfModule mod_mime.c>
AddType font/woff2 .woff2
AddType image/webp .webp
</IfModule>
